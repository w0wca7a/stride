/// <summary>
/// Performs morph target deformation on vertex tangents.
/// </summary>
#ifndef MorphTargetMaxCount
# define MorphTargetMaxCount 8
#endif

shader TangentMeshMorphTargets : TransformationMorphTargets, NormalStream
{
    stage stream float4 MorphTanDelta0 : MORPHTANDELTA0;
    stage stream float4 MorphTanDelta1 : MORPHTANDELTA1;
    stage stream float4 MorphTanDelta2 : MORPHTANDELTA2;
    stage stream float4 MorphTanDelta3 : MORPHTANDELTA3;
    stage stream float4 MorphTanDelta4 : MORPHTANDELTA4;
    stage stream float4 MorphTanDelta5 : MORPHTANDELTA5;
    stage stream float4 MorphTanDelta6 : MORPHTANDELTA6;
    stage stream float4 MorphTanDelta7 : MORPHTANDELTA7;

    override stage void PreTransformPosition()
    {
        base.PreTransformPosition();
        float3 tangentDelta = float3(0, 0, 0);
        int count = min(MorphTargetActiveCount, MorphTargetMaxCount);

        if (count > 0) tangentDelta += streams.MorphTanDelta0.xyz * MorphWeights[0];
        if (count > 1) tangentDelta += streams.MorphTanDelta1.xyz * MorphWeights[1];
        if (count > 2) tangentDelta += streams.MorphTanDelta2.xyz * MorphWeights[2];
        if (count > 3) tangentDelta += streams.MorphTanDelta3.xyz * MorphWeights[3];
        if (count > 4) tangentDelta += streams.MorphTanDelta4.xyz * MorphWeights[4];
        if (count > 5) tangentDelta += streams.MorphTanDelta5.xyz * MorphWeights[5];
        if (count > 6) tangentDelta += streams.MorphTanDelta6.xyz * MorphWeights[6];
        if (count > 7) tangentDelta += streams.MorphTanDelta7.xyz * MorphWeights[7];

        streams.meshTangent.xyz += tangentDelta;
    }
};
