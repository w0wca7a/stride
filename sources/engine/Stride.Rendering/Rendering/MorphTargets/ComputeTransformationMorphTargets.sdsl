shader ComputeTransformationMorphTargets : ComputeShaderBase
{
    // Input buffers — position deltas and normal deltas for all targets
    // Layout: [target0_v0, target0_v1, ..., target0_vN, target1_v0, ..., targetM_vN]
    StructuredBuffer<float4> MorphPositionDeltas;
    StructuredBuffer<float4> MorphNormalDeltas;

    // Outpup buffer — result for vertex shader
    stage RWStructuredBuffer<float4> MorphedPositions;
    stage RWStructuredBuffer<float4> MorphedNormals;

    stage float4 MorphWeights[16];
    stage uint MorphTargetCount;
    stage uint VertexCount;

    override void Compute()
    {
        uint vertexId = streams.DispatchThreadId.x;
        if (vertexId >= VertexCount) return;

        float3 posDelta    = float3(0.0f, 0.0f, 0.0f);
        float3 normalDelta = float3(0.0f, 0.0f, 0.0f);

        for (uint i = 0; i < MorphTargetCount; i++)
        {
            // Unpacking weights float4[16]
            uint vi = i >> 2; // i / 4
            uint ci = i & 3;  // i % 4
            float weight;
            if      (ci == 0) weight = MorphWeights[vi].x;
            else if (ci == 1) weight = MorphWeights[vi].y;
            else if (ci == 2) weight = MorphWeights[vi].z;
            else              weight = MorphWeights[vi].w;

            if (weight == 0.0f) continue;

            uint idx = i * VertexCount + vertexId;

            posDelta    += MorphPositionDeltas[idx].xyz * weight;
            normalDelta += MorphNormalDeltas[idx].xyz   * weight;
        }

        MorphedPositions[vertexId] = float4(posDelta,    0);
        MorphedNormals[vertexId]   = float4(normalDelta, 0);
    }
};
