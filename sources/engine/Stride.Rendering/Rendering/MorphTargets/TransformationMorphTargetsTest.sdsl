shader TransformationMorphTargetsTest : TransformationBase, PositionStream4, NormalStream
{
    rgroup PerDraw.MorphTargetsTest
    {
        //Texture2DArray<float4> MorphTestPositionDeltas;
        Texture2D<float4> MorphTestPositionDeltas;
        Texture2D<float4> MorphTestNormalDeltas;
    }

    cbuffer PerDraw
    {
        stage float MorphTestWeight;
        stage float4 MorphTestWeights[16];        
        stage int MorphTestTargetCount;
        stage int MorphTestVertexCount;
    /*
        stage float4 MorphTestWeight[16];
        stage int MorphTestTargetCount;
        stage int MorphTestVertexCount;
        stage int MorphTestSlicesPerTarget;
        */
    }

    stage stream float3 morphNormalDelta;

    override stage void PreTransformPosition()
    {        
        base.PreTransformPosition();

        int vertexId = (int)streams.VertexID;

        if (vertexId >= MorphTestVertexCount || MorphTestTargetCount <= 0)
            return;

        float3 positionDelta = float3(0, 0, 0);
        float3 normalDelta   = float3(0, 0, 0);
        
        for (int i = 0; i < MorphTestTargetCount; i++)
        {
            int vi = i >> 2;        // i / 4
            int ci = i & 3;         // i % 4

            //float weight = MorphTestWeights[i];
            float weight;
            if      (ci == 0) weight = MorphTestWeights[vi].x;
            else if (ci == 1) weight = MorphTestWeights[vi].y;
            else if (ci == 2) weight = MorphTestWeights[vi].z;
            else              weight = MorphTestWeights[vi].w;

            if (weight == 0)
                continue;

            //float4 delta = MorphTestPositionDeltas.Load(int3(vertexId, i, 0));
            float4 pd = MorphTestPositionDeltas.Load(int3(vertexId, i, 0));
            float4 nd = MorphTestNormalDeltas.Load(int3(vertexId, i, 0));

            //streams.PositionWS.xyz += delta.xyz * MorphTestWeight;
            positionDelta += pd.xyz * weight;
            normalDelta   += nd.xyz * weight;
        }

        streams.PositionWS.xyz += positionDelta;
        streams.morphNormalDelta = normalDelta; // передаём в NormalMesh шейдер

        /* for one target
        if (vertexId < MorphTestVertexCount)
        {
            float4 delta = MorphTestPositionDeltas.Load(int3(vertexId, 0, 0));
            streams.PositionWS.xyz += delta.xyz * MorphTestWeight;
        }
        */
        /*

        // Без if — маска устраняет branching
        float inRange = (float)(vertexId < MorphVertexCount);

        int col = vertexId % 16384;

        for (int t = 0; t < MorphTargetCount; t++)
        {
            int slice = t * MorphSlicesPerTarget + (vertexId / 16384);
            float4 delta = MorphTargetPositionDeltas.Load(int4(col, 0, slice, 0));
            streams.PositionWS.xyz += delta.xyz * GetWeight(t) * inRange;
        }
        */
    }
};
