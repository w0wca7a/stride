/// <summary>
/// Performs morph target deformation on vertex normals.
/// </summary>
#ifndef MorphTargetMaxCount
# define MorphTargetMaxCount 8
#endif

shader NormalMeshMorphTargets : TransformationMorphTargets, NormalStream
{
    stage stream float4 MorphNrmDelta0 : MORPHNRMDELTA0;
    stage stream float4 MorphNrmDelta1 : MORPHNRMDELTA1;
    stage stream float4 MorphNrmDelta2 : MORPHNRMDELTA2;
    stage stream float4 MorphNrmDelta3 : MORPHNRMDELTA3;
    stage stream float4 MorphNrmDelta4 : MORPHNRMDELTA4;
    stage stream float4 MorphNrmDelta5 : MORPHNRMDELTA5;
    stage stream float4 MorphNrmDelta6 : MORPHNRMDELTA6;
    stage stream float4 MorphNrmDelta7 : MORPHNRMDELTA7;

    override stage void PreTransformPosition()
    {
        base.PreTransformPosition();
        float3 normalDelta = float3(0, 0, 0);
        int count = min(MorphTargetActiveCount, MorphTargetMaxCount);

        if (count > 0) normalDelta += streams.MorphNrmDelta0.xyz * MorphWeights[0];
        if (count > 1) normalDelta += streams.MorphNrmDelta1.xyz * MorphWeights[1];
        if (count > 2) normalDelta += streams.MorphNrmDelta2.xyz * MorphWeights[2];
        if (count > 3) normalDelta += streams.MorphNrmDelta3.xyz * MorphWeights[3];
        if (count > 4) normalDelta += streams.MorphNrmDelta4.xyz * MorphWeights[4];
        if (count > 5) normalDelta += streams.MorphNrmDelta5.xyz * MorphWeights[5];
        if (count > 6) normalDelta += streams.MorphNrmDelta6.xyz * MorphWeights[6];
        if (count > 7) normalDelta += streams.MorphNrmDelta7.xyz * MorphWeights[7];

        streams.meshNormal = normalize(streams.meshNormal + normalDelta);
    }
};
